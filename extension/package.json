{
  "name": "big-dill",
  "displayName": "Big Dill",
  "description": "Big Dill Driven Development \u2014 a pytest-bdd test runner and Gherkin authoring toolkit for VS Code.",
  "version": "0.1.0",
  "publisher": "nokout",
  "engines": {
    "vscode": "^1.87.0"
  },
  "categories": [
    "Testing"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/nokout/big-dill"
  },
  "homepage": "https://github.com/nokout/big-dill/blob/main/extension/README.md",
  "bugs": {
    "url": "https://github.com/nokout/big-dill/issues"
  },
  "license": "MIT",
  "keywords": [
    "pytest",
    "pytest-bdd",
    "bdd",
    "gherkin",
    "cucumber",
    "testing"
  ],
  "icon": "icons/marketplace-icon.png",
  "main": "./dist/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Discovering and running tests executes pytest with your selected interpreter, which runs the workspace's own code (conftest.py, fixtures, step definitions). This requires a trusted workspace."
    },
    "virtualWorkspaces": {
      "supported": false,
      "description": "Requires a local filesystem and the ability to spawn a Python subprocess."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "feature",
        "aliases": [
          "Gherkin",
          "feature"
        ],
        "extensions": [
          ".feature"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/feature-light.svg",
          "dark": "./icons/feature-dark.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "feature",
        "scopeName": "text.gherkin",
        "path": "./syntaxes/gherkin.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.yaml": "yaml",
          "meta.embedded.json": "json",
          "meta.embedded.python": "python"
        }
      }
    ],
    "snippets": [
      {
        "language": "feature",
        "path": "./snippets/gherkin.json"
      }
    ],
    "configuration": {
      "title": "Big Dill",
      "properties": {
        "big-dill.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the Big Dill test runner."
        },
        "big-dill.pytestArgs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "Additional arguments passed to pytest."
        },
        "big-dill.cwd": {
          "type": "string",
          "default": "",
          "description": "Working directory for pytest discovery and execution. Overrides python.testing.cwd. Defaults to the workspace root when neither is set."
        },
        "big-dill.pythonPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "Path to the Python interpreter used to run pytest. Takes precedence over the Python extension's selected interpreter. Leave empty to use the Python extension if installed, otherwise `python` from `PATH` \u2014 the Python extension is optional."
        },
        "big-dill.tagNamespace": {
          "type": "string",
          "default": "bdd",
          "markdownDescription": "Namespace prefix shown before Gherkin tags in the Test Explorer filter (e.g. `bdd` \u2192 `@bdd:smoke`). Takes effect after a window reload."
        },
        "big-dill.stepDefinitionGlob": {
          "type": "string",
          "default": "{**/step_defs/**/*.py,**/steps/**/*.py,**/conftest.py}",
          "markdownDescription": "Glob pattern for Python step definition files. Saves to matching files trigger step rediscovery."
        },
        "big-dill.outcomeMapping": {
          "type": "object",
          "description": "Map pytest custom status strings to VSCode test run states. Valid values: passed, failed, errored, skipped, enqueued. Unmapped custom statuses default to errored.",
          "additionalProperties": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "errored",
              "skipped",
              "enqueued"
            ]
          },
          "default": {}
        },
        "big-dill.allowedTags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "description": "If non-empty, any @tag not in this list will be flagged as a warning. Leave empty to disable tag validation."
        },
        "big-dill.phrasingRules": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "pattern": {
                "type": "string",
                "description": "Regex tested against the step text (excluding the Given/When/Then keyword)"
              },
              "message": {
                "type": "string",
                "description": "Diagnostic message shown when the pattern matches"
              }
            },
            "required": [
              "pattern",
              "message"
            ]
          },
          "default": [],
          "description": "Step text phrasing rules. Each rule flags steps whose text matches the regex pattern."
        }
      }
    },
    "views": {
      "explorer": [
        {
          "id": "big-dill.stepBrowser",
          "name": "Step Browser",
          "when": "config.big-dill.enabled"
        }
      ]
    },
    "commands": [
      {
        "command": "big-dill.stepBrowser.groupByFile",
        "title": "Group by File",
        "icon": "$(file)"
      },
      {
        "command": "big-dill.stepBrowser.groupByStepType",
        "title": "Group by Step Type",
        "icon": "$(symbol-class)"
      },
      {
        "command": "big-dill.stepBrowser.groupByTag",
        "title": "Group by Tag",
        "icon": "$(tag)"
      },
      {
        "command": "big-dill.stepBrowser.filter",
        "title": "Filter Steps",
        "icon": "$(filter)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "big-dill.stepBrowser.groupByFile",
          "when": "view == big-dill.stepBrowser",
          "group": "navigation"
        },
        {
          "command": "big-dill.stepBrowser.groupByStepType",
          "when": "view == big-dill.stepBrowser",
          "group": "navigation"
        },
        {
          "command": "big-dill.stepBrowser.groupByTag",
          "when": "view == big-dill.stepBrowser",
          "group": "navigation"
        },
        {
          "command": "big-dill.stepBrowser.filter",
          "when": "view == big-dill.stepBrowser",
          "group": "navigation"
        }
      ]
    },
    "semanticTokenTypes": [
      {
        "id": "gherkinDatatablePipe",
        "description": "Pipe characters in step datatables"
      },
      {
        "id": "gherkinDatatableCell",
        "description": "Cell content in step datatables"
      },
      {
        "id": "gherkinDatatableCellString",
        "description": "Quoted string cell content in step datatables"
      },
      {
        "id": "gherkinExamplesPipe",
        "description": "Pipe characters in Examples tables"
      },
      {
        "id": "gherkinExamplesCell",
        "description": "Cell content in Examples table body"
      },
      {
        "id": "gherkinExamplesCellString",
        "description": "Quoted string cell content in Examples body"
      },
      {
        "id": "gherkinExamplesHeaderCell",
        "description": "Cell content in Examples header row"
      }
    ],
    "semanticTokenScopes": [
      {
        "scopes": {
          "gherkinDatatablePipe": [
            "punctuation.separator"
          ],
          "gherkinDatatableCell": [
            "string.unquoted"
          ],
          "gherkinDatatableCellString": [
            "string.quoted.double"
          ],
          "gherkinExamplesPipe": [
            "punctuation.separator"
          ],
          "gherkinExamplesCell": [
            "variable.other"
          ],
          "gherkinExamplesCellString": [
            "string.quoted.double"
          ],
          "gherkinExamplesHeaderCell": [
            "entity.name.tag"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "editor.tokenColorCustomizations": {
        "textMateRules": [
          {
            "scope": "keyword.control.feature.gherkin",
            "settings": {
              "fontStyle": "bold underline"
            }
          },
          {
            "scope": "entity.name.section.feature.gherkin",
            "settings": {
              "fontStyle": "bold underline"
            }
          },
          {
            "scope": "keyword.control.scenario.gherkin",
            "settings": {
              "fontStyle": "bold underline"
            }
          },
          {
            "scope": "entity.name.section.scenario.gherkin",
            "settings": {
              "fontStyle": "bold underline"
            }
          }
        ]
      }
    }
  },
  "scripts": {
    "compile": "tsc -p tsconfig.json",
    "bundle": "node esbuild.mjs",
    "bundle:production": "node esbuild.mjs --production",
    "watch": "node esbuild.mjs --watch",
    "package": "vsce package --no-dependencies --no-rewrite-relative-links",
    "package:marketplace": "vsce package --no-dependencies --baseImagesUrl https://raw.githubusercontent.com/nokout/big-dill/main/extension",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:integration": "npm run compile && npm run bundle && vscode-test",
    "vscode:prepublish": "npm run bundle:production"
  },
  "overrides": {
    "cheerio": "1.0.0-rc.12"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.87.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.9.2",
    "esbuild": "^0.25.12",
    "eslint": "^10.8.0",
    "jest": "^30.4.2",
    "ovsx": "^1.0.2",
    "ts-jest": "^29.4.12",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.65.0"
  },
  "dependencies": {
    "@nokout/big-dill-core": "^0.1.0"
  }
}
