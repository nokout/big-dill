{
  "python.testing.pytestEnabled": false,
  "python.testing.unittestEnabled": false,
  "python.testing.autoTestDiscoverOnSaveEnabled": false,
  "big-dill.enabled": true,
  "big-dill.cwd": "./playground",
  "python.defaultInterpreterPath": "${workspaceFolder}/playground/.venv/bin/python",
  "big-dill.outcomeMapping": {
    "waiting": "enqueued",
    "knownError": "errored"
  }
}
